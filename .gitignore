# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ScratchPy working files
scratchpy_settings.json
scratchpy_log.txt
scratchpy_blocks/
scratchpy_selftest/
*.spy

# Generated programs. ScratchPy writes a .py next to the project for every
# tab, so ignore everything at the top level except the project's own files.
/*.py
!/scratchpy_studio.py
!/build_apps.py

# Build output
build/
dist/
*.spec
